{
  "name": "swarm-review",
  "version": "1.0.0",
  "description": "A chapter-review platform for the shared-universe project The Swarm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test 'test/**/*.test.js'",
