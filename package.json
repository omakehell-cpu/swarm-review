{
  "name": "swarm-review",
  "version": "1.0.0",
  "description": "A chapter-review platform for the shared-universe project The Swarm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test 'test/**/*.test.js'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "a11y": "node scripts/a11y-audit.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "@typescript/typescript-linux-arm64": "^7.0.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "mammoth": "^1.12.3",
    "markdown-it": "^15.0.2",
    "pdfkit": "^0.20.2"
  }
}
