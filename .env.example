# Copia este archivo a ".env" si quieres fijar estos valores a mano.
# Si no defines nada, la app genera y guarda unos valores automaticamente
# en la carpeta data/ la primera vez que arranca.

# Puerto en el que escucha el servidor
PORT=3000

# Clave secreta para firmar las cookies de sesion. Si no la defines,
# se genera una aleatoria y se guarda en data/session.secret.
SESSION_SECRET=

# Ponlo a 1 SOLO cuando la app se sirva de verdad por https:// (por ejemplo
# detras de un Cloudflare Tunnel o un proxy con TLS delante -- ver
# SETUP-DOMAIN.md). Marca la cookie de sesion como "Secure": el navegador
# entonces se niega a enviarla por una conexion http:// normal, que es lo
# que quieres en produccion. Dejalo en blanco/0 mientras pruebes en
# localhost -- si lo activas ahi, el login parecera fallar en silencio,
# porque el navegador descarta la cookie al no haber https.
SECURE_COOKIES=

# Base URL of the shared-universe wiki used for auto-linking character/
# place/ship names in chapter text (see lib/wiki.js and the "Wiki linking"
# section on /admin). Defaults to https://tampaad.net if left blank.
WIKI_BASE_URL=
